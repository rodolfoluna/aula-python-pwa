{
  "name": "aula-python-prueba-tecnica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:editor": "node scripts/build-editor.mjs",
    "build:windows-export": "node scripts/build-windows-export.mjs",
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "start:production": "node scripts/build-pwa.mjs && node accounts/server.mjs",
    "build:pwa": "node scripts/build-pwa.mjs",
    "pretest": "node scripts/build-pwa.mjs",
    "build:runner": "node scripts/build-runner.mjs",
    "accounts": "node scripts/build-pwa.mjs && node --env-file-if-exists=.env accounts/server.mjs",
    "teacher:init": "node --env-file-if-exists=.env scripts/create-teacher.mjs",
    "teacher:repair": "node --env-file-if-exists=.env scripts/repair-teachers.mjs",
    "teacher:reset": "node --env-file-if-exists=.env scripts/reset-teacher.mjs",
    "supabase:check": "node --env-file-if-exists=.env scripts/check-supabase.mjs",
    "activities:check": "node --env-file-if-exists=.env scripts/check-activities.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@electric-sql/pglite": "0.5.10",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.4",
    "jsdom": "29.1.1",
    "marked": "18.1.1",
    "pyodide": "0.27.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
